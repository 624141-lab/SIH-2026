# IDR System - AI-ML Intelligent Dead Reckoning
# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/

# Data (large files - never commit raw dataset or preprocessed caches)
data/
*.zip
*.pbf
*.graphml
*.npz
!results/*.npz

# Model checkpoints (keep root/temp ignored, track committed weights in models/)
*.pt
*.pth
*.onnx
*.tflite
!models/*.pt
!models/*.onnx
!models/*.tflite

# Pytest & IDE
.pytest_cache/
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Environment & Logs
.env
*.log

# Figures and Results tracking
!results/figures/*.png
!results/figures/*.jpg
!results/figures/*.svg
!reports/figures/*.png
!results/*.csv
